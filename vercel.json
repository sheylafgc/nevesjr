{
  "rewrites": [
    {
      "source": "/(en|pt|es)/:path*",
      "destination": "/:path*?locale=:1"
    },
    {
      "source": "/(en|pt|es)",
      "destination": "/?locale=:1"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "x-vercel-rewrite",
          "value": "1"
        }
      ]
    }
  ]
}
